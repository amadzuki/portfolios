{
  "name": "@portfolios/board",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "name": "board",
    "tags": [
      "scope:app"
    ],
    "targets": {
      "dev": {
        "command": "vite dev",
        "options": {
          "cwd": "{projectRoot}"
        },
        "continuous": true
      },
      "build": {
        "command": "vite build",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build",
          "^typecheck"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/build"
        ]
      },
      "start": {
        "command": "PORT=4601 node server.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "continuous": true
      },
      "typecheck": {
        "command": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^typecheck"
        ],
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ]
      }
    }
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "lib0": "^0.2.120",
    "@portfolios/llm": "workspace:*",
    "ws": "^8.23.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/ws": "^8.18.2",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
