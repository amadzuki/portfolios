{
  "name": "@portfolios/data-chat",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "name": "data-chat",
    "tags": [
      "scope:app"
    ],
    "targets": {
      "dev": {
        "command": "react-router dev --port 4500",
        "options": {
          "cwd": "{projectRoot}"
        },
        "continuous": true
      },
      "build": {
        "command": "react-router build",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build",
          "^typecheck"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/build"
        ]
      },
      "start": {
        "command": "PORT=4501 react-router-serve ./build/server/index.js",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "continuous": true
      },
      "typecheck": {
        "command": "react-router typegen && tsc --noEmit -p tsconfig.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^typecheck"
        ],
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ]
      }
    }
  },
  "scripts": {
    "samples": "bun scripts/make-samples.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@portfolios/llm": "workspace:*",
    "@react-router/node": "8.5.2",
    "@react-router/serve": "8.5.2",
    "@visx/axis": "4.0.0",
    "@visx/curve": "4.0.0",
    "@visx/grid": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "d3-array": "^3.2.5",
    "idb-keyval": "^6.3.0",
    "isbot": "^5.2.3",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-array": "^3.2.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
