{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "composite": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable", "webworker"],
    "types": ["vite/client", "node"],
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    ".react-router/types/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    "react-router.config.ts",
    "scripts/**/*.ts"
  ],
  "references": [
    {
      "path": "../../libs/llm"
    }
  ]
}
