# ── LLM provider selection ─────────────────────────────────────────────
# Switch vendors by changing these values only. Supported:
# glm | anthropic | openai | google | openrouter | ollama
LLM_PROVIDER=glm

# Optional per-role model overrides (each provider has sensible defaults)
# LLM_MODEL_CHAT=glm-4.6
# LLM_MODEL_FAST=glm-4.5-air
# LLM_MODEL_CODE=glm-4.6

# Embeddings can use a different vendor (needed when the chat vendor has none, e.g. anthropic)
# LLM_EMBED_PROVIDER=glm
# LLM_MODEL_EMBED=embedding-3

# ── Provider credentials (only the ones you use) ──────────────────────
GLM_API_KEY=
# Mainland endpoint: https://open.bigmodel.cn/api/paas/v4
# GLM_BASE_URL=https://api.z.ai/api/paas/v4
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── apps/web ──────────────────────────────────────────────────────────
# Where the Lumen Drift card links to (defaults to https://game.ahmadmarzuki.com)
# NEXT_PUBLIC_GAME_URL=http://localhost:4300
